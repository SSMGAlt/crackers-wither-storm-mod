# ── Gradle ────────────────────────────────────────────────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Gradle local override files
gradle-app.setting
!**/src/main/**/build/
!**/src/test/**/build/

# ── IntelliJ IDEA ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
out/
!.idea/modules.xml
!.idea/.gitignore

# ── Eclipse ───────────────────────────────────────────────────────────────────
bin/
*.launch
.settings/
.metadata/
.classpath
.project
eclipse/

# ── Forge / ForgeGradle ───────────────────────────────────────────────────────
run/
run-data/
runs/
mcmodsrepo/
forge*changelog.txt

# ── Generated resources (datagen output) ──────────────────────────────────────
src/generated/resources/
!src/generated/resources/.cache/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Java ──────────────────────────────────────────────────────────────────────
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ── Crash / log files ─────────────────────────────────────────────────────────
crash-reports/
logs/
*.log
