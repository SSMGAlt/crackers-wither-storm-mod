# ── Default behaviour ─────────────────────────────────────────────────────────
* text=auto eol=lf

# ── Java source ───────────────────────────────────────────────────────────────
*.java text eol=lf
*.kt   text eol=lf

# ── Gradle ────────────────────────────────────────────────────────────────────
*.gradle      text eol=lf
*.properties  text eol=lf
gradlew       text eol=lf
gradlew.bat   text eol=crlf

# ── JSON / TOML / XML ─────────────────────────────────────────────────────────
*.json  text eol=lf
*.toml  text eol=lf
*.xml   text eol=lf

# ── Shaders ───────────────────────────────────────────────────────────────────
*.glsl text eol=lf
*.fsh  text eol=lf
*.vsh  text eol=lf

# ── Markdown / plain text ─────────────────────────────────────────────────────
*.md   text eol=lf
*.txt  text eol=lf

# ── GitHub Actions ────────────────────────────────────────────────────────────
*.yml  text eol=lf
*.yaml text eol=lf

# ── Binaries (no diff / no merge) ─────────────────────────────────────────────
*.jar    binary
*.png    binary
*.ogg    binary
*.wav    binary
*.gif    binary
*.ico    binary
*.zip    binary

# ── Generated resources (always LF, suppress diff noise) ──────────────────────
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json       text eol=lf
